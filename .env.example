PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8080
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-existing-supabase-publishable-or-anon-key
# Required in production (32+ characters): openssl rand -hex 32
SESSION_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq is preferred when configured; Gemini is the fallback. Only one key is required.
GROQ_API_KEY=
# Optional override only. Leave unset for automatic model selection.
# GROQ_MODEL=auto
# Only enable when a trusted reverse proxy replaces X-Forwarded-For.
TRUST_PROXY=false
AI_DAILY_LIMIT=500

# Optional: absolute path on persistent disk; defaults to backend/knowledge/restaurant.md
# Copy the seed Markdown document to this path before starting the server.
KNOWLEDGE_BASE_PATH=

# Reservations (table booking). The service-role key bypasses RLS: keep it on the server only.
SUPABASE_SERVICE_ROLE_KEY=
RESTAURANT_TIMEZONE=Asia/Ho_Chi_Minh
# SMTP for booking OTP and status emails. Without MAIL_HOST, development prints emails/OTP to the console
# and production refuses online bookings.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Web push for admin booking alerts (VAPID keys, base64url). Generate once, e.g. npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@riversideterrace.vn

# Menu and table photos (Cloudinary). Either CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# or the three variables below. In production the deploy job writes CLOUDINARY_URL from the GitHub secret.
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Public website used for links in booking emails (defaults to the first FRONTEND_ORIGIN).
PUBLIC_SITE_URL=
